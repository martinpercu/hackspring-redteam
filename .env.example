# Copiar a .env y completar. NUNCA commitear .env (esta en .gitignore).
# --- Daytona (CORE, la unica key critica) --- https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# --- OpenAI: el agente victima (gpt-4o-mini) --- 
OPENAI_API_KEY=
VICTIM_MODEL=gpt-4o-mini
# --- Arize AX (Best Use of Arize) --- Space Settings -> API Keys
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=redteam-live
# --- ElevenLabs (voz) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_ID_2=            # 2da voz para "attacker" (opcional; si falta usa la 1ra)
# --- Anchor Browser (opcional; creditos en el evento) ---
ANCHORBROWSER_API_KEY=
BROWSE_BACKEND=direct               # direct | anchor
# --- SurrealDB: vacio = embebido surrealkv (persiste en ./.surreal_data, sin Docker) ---
SURREAL_URL=
SURREAL_NS=redteam
SURREAL_DB=memory
# --- Dashboard ---
DASHBOARD_PORT=8787
